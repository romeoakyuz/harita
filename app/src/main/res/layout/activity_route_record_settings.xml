<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Rota Kayıt Ayarları"
        android:textSize="20sp"
        android:textStyle="bold"
        android:layout_marginBottom="20dp"/>

    <LinearLayout
        android:id="@+id/cardWalk"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp"
        android:clickable="true"
        android:layout_marginBottom="16dp"
        android:background="@drawable/bg_route_card">
        <RadioButton
            android:id="@+id/rbModeWalk"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Yürüyüş"
            android:textSize="18sp"
            android:textStyle="bold"/>
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="GPS Güncelleme Sıklığı"
            android:textSize="12sp"
            android:textColor="#9E9E9E"/>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">
            <TextView android:id="@+id/chipWalk1" android:layout_width="0dp" android:layout_height="44dp" android:layout_weight="1" android:layout_marginEnd="8dp" android:gravity="center" android:text="1 sn" android:textSize="16sp" android:background="@drawable/bg_route_chip"/>
            <TextView android:id="@+id/chipWalk3" android:layout_width="0dp" android:layout_height="44dp" android:layout_weight="1" android:layout_marginEnd="8dp" android:gravity="center" android:text="3 sn" android:textSize="16sp" android:background="@drawable/bg_route_chip"/>
            <TextView android:id="@+id/chipWalk5" android:layout_width="0dp" android:layout_height="44dp" android:layout_weight="1" android:layout_marginEnd="8dp" android:gravity="center" android:text="5 sn" android:textSize="16sp" android:background="@drawable/bg_route_chip"/>
            <TextView android:id="@+id/chipWalk10" android:layout_width="0dp" android:layout_height="44dp" android:layout_weight="1" android:gravity="center" android:text="10 sn" android:textSize="16sp" android:background="@drawable/bg_route_chip"/>
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/cardCar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp"
        android:clickable="true"
        android:background="@drawable/bg_route_card">
        <RadioButton
            android:id="@+id/rbModeCar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Araç"
            android:textSize="18sp"
            android:textStyle="bold"/>
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="GPS Güncelleme Sıklığı"
            android:textSize="12sp"
            android:textColor="#9E9E9E"/>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">
            <TextView android:id="@+id/chipCar1" android:layout_width="0dp" android:layout_height="44dp" android:layout_weight="1" android:layout_marginEnd="8dp" android:gravity="center" android:text="1 sn" android:textSize="16sp" android:background="@drawable/bg_route_chip"/>
            <TextView android:id="@+id/chipCar3" android:layout_width="0dp" android:layout_height="44dp" android:layout_weight="1" android:layout_marginEnd="8dp" android:gravity="center" android:text="3 sn" android:textSize="16sp" android:background="@drawable/bg_route_chip"/>
            <TextView android:id="@+id/chipCar5" android:layout_width="0dp" android:layout_height="44dp" android:layout_weight="1" android:layout_marginEnd="8dp" android:gravity="center" android:text="5 sn" android:textSize="16sp" android:background="@drawable/bg_route_chip"/>
            <TextView android:id="@+id/chipCar10" android:layout_width="0dp" android:layout_height="44dp" android:layout_weight="1" android:gravity="center" android:text="10 sn" android:textSize="16sp" android:background="@drawable/bg_route_chip"/>
        </LinearLayout>
    </LinearLayout>

</LinearLayout>
